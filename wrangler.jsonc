{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pet-refuge",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pet-refuge-db",
			"database_id": "d22d647a-33e8-42d0-a0a2-ada5d2cacacd",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "pet-refuge-documentos"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"CATALOG_CACHE": "on"
	},
	"observability": {
		"enabled": true
	}
}
