{
  "name": "pet-refuge", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "wrangler dev", "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "setup:local": "node scripts/setup-local.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "deploy": "wrangler deploy", "check": "node --check src/worker.js && node --check public/app.js"
  },
  "devDependencies": {"wrangler": "^4.0.0", "@playwright/test": "^1.58.0", "miniflare": "^4.0.0"},
  "engines": {"node": ">=22"}
}
